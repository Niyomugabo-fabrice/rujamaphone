generator client {
  provider        = "prisma-client-js"
  // Prisma 7 requires an output path
  output          = "./generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// SHARED SYSTEM ENUMS
// ==========================================

enum Condition {
  NEW
  USED
}

enum StorageCapacity {
  GB64
  GB128
  GB256
  GB512
  TB1
}

enum SmartphoneBrand {
  APPLE
  SAMSUNG
  GOOGLE
  XIAOMI
  ONEPLUS
  TECNO
  INFINIX
}

enum SpeakerBrand {
  JBL
  SONY
  BOSE
  APPLE
  ANKER
  BEATS
  ULTIMATE_EARS
  MARSHALL
  SONOS
}

enum AccessoryBrand {
  APPLE
  SAMSUNG
  ANKER
  BASEUS
  GENERIC
  ONEPLUS
  SONY
  XIAOMI
  SPIGEN
  BELKIN
  OTTERBOX
  JBL
  BEATS
  BOSE
  MOPHIE
  CASETIFY
  GOOGLE
  UAG
  JABRA
  NOMAD
  NOTHING
  MOUS
  SENNHEISER
  RAVPOWER
}

enum AnnouncementKind {
  GENERAL
  PROMOTION
  PUBLIC_HOLIDAY
}

// ==========================================
// USER MODEL
// ==========================================

model User {
  id            String    @id @default(uuid())
  fullName      String
  email         String    @unique
  password      String
  avatar        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  // Password reset token
  resetToken        String?
  resetTokenExpires DateTime?

  @@index([email])
}

// ==========================================
// CORE HARDWARE PRODUCT MODELS
// ==========================================

model Smartphone {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[] // Native array of image strings
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Hardware Fields
  storage   StorageCapacity
  condition Condition
  brand     SmartphoneBrand

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model Speaker {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[]
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Hardware Fields (No Storage!)
  condition   Condition
  brand       SpeakerBrand
  batteryLife String? // Optional performance metric specific to sound hardware

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model Accessory {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[]
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Fields (Clean of storage rules)
  condition Condition
  brand     AccessoryBrand
  type      String // e.g., "Cable", "Case", "Charger", "Screen Protector"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model SliderImage {
  id        String   @id @default(uuid())
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String           @id @default(uuid())
  title       String
  message     String
  kind        AnnouncementKind @default(GENERAL)
  isPublished Boolean          @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdAt])
}
