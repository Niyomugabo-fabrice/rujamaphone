generator client {
  provider        = "prisma-client-js"
  // Prisma 7 requires an output path
  output          = "./generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// SHARED SYSTEM ENUMS
// ==========================================

enum Condition {
  NEW
  USED
}

enum AnnouncementKind {
  GENERAL
  PROMOTION
  PUBLIC_HOLIDAY
}

// ==========================================
// USER MODEL
// ==========================================

model User {
  id            String    @id @default(uuid())
  fullName      String
  email         String    @unique
  password      String
  avatar        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  // Password reset token
  resetToken        String?
  resetTokenExpires DateTime?

  @@index([email])
}

// ==========================================
// CORE HARDWARE PRODUCT MODELS
// ==========================================

model Smartphone {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[] // Native array of image strings
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Hardware Fields
  storage   String // Flexible storage capacity (e.g., "64GB", "128GB", "256GB", "512GB", "1TB")
  condition Condition
  brand     String // Flexible brand name (e.g., "Apple", "Samsung", "Google", "Xiaomi", etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model Speaker {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[]
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Hardware Fields (No Storage!)
  condition   Condition
  brand       String // Flexible brand name (e.g., "JBL", "Sony", "Bose", "Apple", etc.)
  batteryLife String? // Optional performance metric specific to sound hardware

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model Accessory {
  id          String   @id @default(uuid())
  name        String
  price       Int // Value mapped in RWF
  image       String[]
  description String?
  rating      Float    @default(0)
  reviews     Int      @default(0)

  // Specific Required Fields (Clean of storage rules)
  condition Condition
  brand     String // Flexible brand name (e.g., "Apple", "Samsung", "Anker", etc.)
  type      String // e.g., "Cable", "Case", "Charger", "Screen Protector"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([brand, price])
}

model SliderImage {
  id        String   @id @default(uuid())
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String           @id @default(uuid())
  title       String
  message     String
  kind        AnnouncementKind @default(GENERAL)
  isPublished Boolean          @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdAt])
}
